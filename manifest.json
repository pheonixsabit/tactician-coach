{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Tactician Coach: TFT Post-Game Analyzer",
    "version": "0.0.1",
    "minimum-overwolf-version": "0.230.0",
    "author": "Tactician Coach Team",
    "description": "Instant post-game TFT analysis, comp alignment scoring, BIS item evaluations, and tactical coaching.",
    "icon": "assets/icons/icon.png",
    "icon_gray": "assets/icons/icon.png",
    "launcher_icon": "assets/icons/icon.png",
    "window_icon": "assets/icons/icon.png"
  },
  "permissions": [
    "FileSystem",
    "Extensions",
    "Hotkeys"
  ],
  "data": {
    "start_window": "background",
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [
        21570,
        5426
      ]
    },
    "game_events": [
      21570,
      5426
    ],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [
            21570,
            5426
          ]
        },
        "start_minimized": true
      }
    ],
    "windows": {
      "background": {
        "file": "src/windows/background/background.html",
        "is_background_page": true
      },
      "post_game": {
        "file": "src/windows/post_game/post_game.html",
        "transparent": true,
        "resizable": false,
        "use_default_browser": false,
        "size": {
          "width": 380,
          "height": 500
        },
        "min_size": {
          "width": 380,
          "height": 500
        },
        "topmost": true
      },
      "desktop": {
        "file": "src/windows/desktop/desktop.html",
        "transparent": false,
        "resizable": true,
        "size": {
          "width": 1200,
          "height": 800
        },
        "min_size": {
          "width": 900,
          "height": 600
        }
      }
    },
    "hotkeys": {
      "toggle_post_game": {
        "title": "Toggle Post-Game Overlay",
        "action-type": "toggle",
        "default": "Alt+T"
      }
    }
  }
}
